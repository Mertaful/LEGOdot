; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ConsoleCommands"
config/description="Simple Lego piece for prototyping to enable user to have easy to use console commands."
config/version="0.5"
config/tags=PackedStringArray("developer_tools", "lego", "prototyping")
run/main_scene="uid://c7urfixv4f2hj"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="uid://dm2gcnc070nte"

[autoload]

Console="*uid://c5wm6mi73aova"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="ConsoleCommands"

[file_customization]

folder_colors={
"res://lego_pieces/": "teal"
}

[input]

ui_text_caret_up={
"deadzone": 0.5,
"events": []
}
ui_text_caret_down={
"deadzone": 0.5,
"events": []
}
toggle_console={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":96,"key_label":0,"unicode":167,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
