[gd_scene format=3 uid="uid://c7urfixv4f2hj"]

[sub_resource type="GDScript" id="GDScript_j75cp"]
script/source = "extends Node3D

@onready var bouncy_boi: CSGBox3D = %BouncyBoi


var original_boi_pos : Vector3
var rotation_speed := 3.0
var sin_offset := 0.0
var sin_frequency := 4.0
var sin_amplitude := 0.5
var spinning := true

func _init() -> void:
	Console.add_bool_command(\"bouncyboi.spin\", func(flag : bool): spinning = flag)
	Console.add_float_command(\"bouncyboi.speed\", func(speed : float): rotation_speed = speed)
	Console.add_float_command(\"bouncyboi.frequency\", func(frequency : float): sin_frequency = frequency)

func _ready() -> void:
	original_boi_pos = bouncy_boi.global_position
	original_boi_pos.y += sin_amplitude

func _process(delta: float) -> void:
	sin_offset = sin_offset + delta
	if sin_offset > PI:
		sin_offset -= PI
	
	var frame_offset = sin(sin_offset * sin_frequency) * sin_amplitude
	
	bouncy_boi.global_position.y = original_boi_pos.y + frame_offset
	if spinning:
		bouncy_boi.rotate_y(delta * rotation_speed)
"

