[gd_scene format=3 uid="uid://dm11hycltk6qj"]

[ext_resource type="Texture2D" uid="uid://7ja7fp6nfet2" path="res://preview/skybox-day.png" id="2_l3l1w"]

[sub_resource type="GDScript" id="GDScript_xwukp"]
script/source = "extends Node3D

const PREVIEW_2D_DAMAGE_TEXT = preload(\"uid://c4olw0odakac5\")
const PREVIEW_DAMAGE_NUMBERS_3D = preload(\"uid://cj1pnowq8b5e6\")

enum preview_damage_number_types {DEFAULT, CRIT, MAGIC}

@onready var csg_sphere_3d: CSGSphere3D = $CSGSphere3D

var sphere_offset := 0.0

#func _on_d_damage_button_pressed() -> void:
	#var test_damage_number := DamageNumber2D.new(get_viewport().get_mouse_position(), PREVIEW_2D_DAMAGE_TEXT, \"%d\" % randi_range(1, 100), preview_damage_number_types.DEFAULT)
	#get_tree().root.add_child(test_damage_number)


func _process(delta: float) -> void:
	var frequency := 4.0
	var amplitude := 1.0
	
	sphere_offset += delta
	if sphere_offset > PI:
		sphere_offset -= PI
	
	csg_sphere_3d.global_position.x = sin(sphere_offset * frequency) * amplitude
	

func _on_crit_pressed() -> void:
	var test_damage_number := DamageNumber2D.new(get_viewport().get_mouse_position(), PREVIEW_2D_DAMAGE_TEXT, randi_range(1, 100), preview_damage_number_types.CRIT)
	get_tree().root.add_child(test_damage_number)


func _on_magic_pressed() -> void:
	var test_damage_number := DamageNumber2D.new(get_viewport().get_mouse_position(), PREVIEW_2D_DAMAGE_TEXT, randi_range(1, 100), preview_damage_number_types.MAGIC)
	get_tree().root.add_child(test_damage_number)



func _on_d_damage_button_gui_input(_event: InputEvent) -> void:
	var test_damage_number := DamageNumber2D.new(get_viewport().get_mouse_position(), PREVIEW_2D_DAMAGE_TEXT, randi_range(1, 100), preview_damage_number_types.DEFAULT)
	get_tree().root.add_child(test_damage_number)


func _on_d_button_pressed() -> void:
	var test_damage_number := DamageNumber3D.new(csg_sphere_3d.global_position, PREVIEW_DAMAGE_NUMBERS_3D, randi_range(1, 100), randi_range(0, 2))
	get_tree().root.add_child(test_damage_number)
"

