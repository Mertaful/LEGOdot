[gd_scene format=3 uid="uid://dbtlj33rre0th"]

[sub_resource type="GDScript" id="GDScript_x15ge"]
script/source = "@tool
extends Control

signal execute
signal cancelled

@onready var _confirm: Button = %Confirm
@onready var _cancel: Button = %Cancel
@onready var _panel_container: PanelContainer = %PanelContainer
@onready var check_box: CheckBox = %CheckBox

@onready var shape_type_option_button: OptionButton = %ShapeTypeOptionButton


func get_size() -> Vector2:
	return _panel_container.size

func _ready() -> void:
	var base_control := EditorInterface.get_base_control()
	for child in get_children(true):
		child.theme = base_control.theme
	
	_panel_container.add_theme_stylebox_override(\"panel\", base_control.get_theme_stylebox(\"panel\", \"ConfirmationDialog\"))
	
	_confirm.pressed.connect(_confirm_pressed)
	_cancel.pressed.connect(_cancel_pressed)


func _confirm_pressed() -> void:
	execute.emit(shape_type_option_button.selected, check_box.button_pressed)

func _cancel_pressed() -> void:
	cancelled.emit()
"

