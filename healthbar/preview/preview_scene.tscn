[sub_resource type="GDScript" id="GDScript_g4dk2"]
script/source = "extends Node2D

const PREVIEW_PARTICLE = preload(\"uid://dlm8db84xhinv\")



func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"take_damage\"):
		$Healthbar.apply_change(-10.0)
	if event.is_action_pressed(\"heal\"):
		$Healthbar.apply_change(10.0)


func _on_healthbar_on_damaged(bar_position: Vector2) -> void:
	var new_particle : CPUParticles2D = PREVIEW_PARTICLE.instantiate()
	new_particle.global_position = bar_position
	add_child(new_particle)
	new_particle.emitting = true
"

